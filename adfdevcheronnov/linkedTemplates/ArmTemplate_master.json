{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevcheronnov"
		},
		"LS_SQLSERVER_ADVENTRURE_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLSERVER_ADVENTRURE_DB'"
		},
		"LS_Src_Onprem_SqlServer_DW_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Src_Onprem_SqlServer_DW'"
		},
		"LS_ADLS_ADLS_GENERIC_PARAM_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().adlsstorageaccounrname}"
		},
		"LS_AzureKeyVaultdevchevron_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvaultdevchevron.vault.azure.net/"
		},
		"LS_REST_API_ADLS_SRC_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().restAPIBaseURL}"
		},
		"LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ZINEETH\\SQLEXPRESS"
		},
		"LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2025"
		},
		"LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"LS_SQL_ADLS_SINK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().URL}"
		},
		"LS_SqlTable_Parquet_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevcheronnov.dfs.core.windows.net"
		},
		"LS_Src_Onprem_SqlServer_DW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ZINEETH\\SQLEXPRESS"
		},
		"LS_Src_Onprem_SqlServer_DW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlmigration"
		},
		"LS_Src_Onprem_SqlServer_DW_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdevcheronnov_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQLSERVER_ADVENTRURE_DB_password": {
						"value": "[parameters('LS_SQLSERVER_ADVENTRURE_DB_password')]"
					},
					"LS_Src_Onprem_SqlServer_DW_password": {
						"value": "[parameters('LS_Src_Onprem_SqlServer_DW_password')]"
					},
					"LS_ADLS_ADLS_GENERIC_PARAM_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_ADLS_GENERIC_PARAM_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVaultdevchevron_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVaultdevchevron_properties_typeProperties_baseUrl')]"
					},
					"LS_REST_API_ADLS_SRC_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_API_ADLS_SRC_properties_typeProperties_url')]"
					},
					"LS_SQL_ADLS_SINK_properties_typeProperties_url": {
						"value": "[parameters('LS_SQL_ADLS_SINK_properties_typeProperties_url')]"
					},
					"LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_server')]"
					},
					"LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_database')]"
					},
					"LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLSERVER_ADVENTRURE_DB_properties_typeProperties_userName')]"
					},
					"LS_SqlTable_Parquet_properties_typeProperties_url": {
						"value": "[parameters('LS_SqlTable_Parquet_properties_typeProperties_url')]"
					},
					"LS_Src_Onprem_SqlServer_DW_properties_typeProperties_server": {
						"value": "[parameters('LS_Src_Onprem_SqlServer_DW_properties_typeProperties_server')]"
					},
					"LS_Src_Onprem_SqlServer_DW_properties_typeProperties_database": {
						"value": "[parameters('LS_Src_Onprem_SqlServer_DW_properties_typeProperties_database')]"
					},
					"LS_Src_Onprem_SqlServer_DW_properties_typeProperties_userName": {
						"value": "[parameters('LS_Src_Onprem_SqlServer_DW_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfdevcheronnov_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfdevcheronnov_ArmTemplate_0')]"
			]
		}
	]
}